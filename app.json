{
  "expo": {
    "name": "MinimalistKalori",
    "slug": "MinimalistKalori",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "minimalistkalori",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSHealthShareUsageDescription": "Adım sayısı, aktif enerji ve kilo verilerini okuyup günlük kalori hedefini kişiselleştirmek için Apple Health erişimi istiyoruz.",
        "NSHealthUpdateUsageDescription": "Eklediğin öğünlerin kalori ve makro değerlerini ve su tüketimini Apple Health'e kaydetmek için erişim istiyoruz."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Yemeğinin fotoğrafını çekmek ve ambalajlı ürünlerin barkodunu okuyup besin değerlerini getirmek için kameranı kullanmamıza izin ver."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
