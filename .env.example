# USDA FoodData Central API anahtarı — https://fdc.nal.usda.gov/api-key-signup.html
# scripts/fetch-usda.ts bu değeri okur. Anahtar verilmezse "DEMO_KEY" kullanılır
# (saatte ~30 istek sınırlı; sadece küçük testler için).
USDA_API_KEY=

# İstekler arası bekleme (ms). USDA sınırı saatte 1000 istek ≈ 3.6 sn/istek.
USDA_FETCH_DELAY_MS=3600

# Barkod tarayıcının USDA yedeği (app/barkod.tsx) için istemciye gömülen anahtar.
# EXPO_PUBLIC_ öneki zorunlu. Boş bırakılırsa DEMO_KEY kullanılır (saatte ~30 istek).
EXPO_PUBLIC_USDA_API_KEY=
